PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm2mart
JWT_SECRET=replace-with-a-long-random-secret
OTP_TTL_MINUTES=5

# ================================================================
# Exotel Cloud Telephony & SMS Configuration
# Get your credentials at: https://my.exotel.com/
# ================================================================
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=your_exotel_virtual_number
EXOTEL_DLT_ENTITY_ID=your_dlt_entity_id
EXOTEL_DLT_TEMPLATE_ID=your_dlt_template_id

# Optional legacy Twilio fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
